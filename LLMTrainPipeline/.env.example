# Gemini API Key (for AI features, optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Default model path (optional, can be set in UI)
# DEFAULT_MODEL_PATH=/path/to/your/model

# Server port (optional)
# PORT=3000
