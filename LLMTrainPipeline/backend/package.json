{
    "name": "nexus-ai-backend",
    "version": "1.0.0",
    "type": "module",
    "description": "Backend for Nexus AI LLM Training Pipeline",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "stable": "tsx src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:push": "prisma db push",
        "db:seed": "tsx src/db/seed.ts",
        "db:studio": "prisma studio",
        "test": "vitest run",
        "lint": "eslint src --ext .ts"
    },
    "dependencies": {
        "@fastify/cors": "^9.0.1",
        "@fastify/static": "^7.0.4",
        "@fastify/swagger": "^8.14.0",
        "@fastify/swagger-ui": "^3.0.0",
        "@prisma/client": "^5.14.0",
        "archiver": "^7.0.1",
        "axios": "^1.13.2",
        "fastify": "^4.27.0",
        "js-yaml": "^4.1.0",
        "uuid": "^9.0.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/archiver": "^7.0.0",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^20.12.12",
        "@types/uuid": "^9.0.8",
        "@typescript-eslint/eslint-plugin": "^7.10.0",
        "@typescript-eslint/parser": "^7.10.0",
        "eslint": "^8.57.0",
        "prisma": "^5.14.0",
        "tsx": "^4.11.0",
        "typescript": "^5.4.5",
        "vitest": "^1.6.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}